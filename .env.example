# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=churn_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/churn_db

# MLflow
# NOTE: host port defaults to 5001 (not 5000) because macOS AirPlay Receiver
# occupies 5000 on many machines. Internal container port stays 5000.
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://mlflow:5000

# Backend
BACKEND_PORT=8000
CHROMA_PERSIST_DIR=/app/chroma_store

# Frontend
# NOTE: host port defaults to 8502 (not Streamlit's usual 8501) to avoid
# clashing with other Streamlit projects that may already be running.
FRONTEND_PORT=8502
BACKEND_URL=http://backend:8000

# Ingestion
INGESTION_PORT=8001
INGESTION_INTERVAL_MINUTES=60

# LLM API (agent tool-calling), via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
